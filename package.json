{
  "name": "abb-rws-client",
  "version": "1.5.3",
  "description": "Typed TypeScript/Node.js client for ABB Robot Web Services - supports both RWS 1.0 (IRC5/RobotWare 6) and RWS 2.0 (OmniCore/RobotWare 7 and 8).",
  "keywords": [
    "abb",
    "robot",
    "rws",
    "robot-web-services",
    "irc5",
    "omnicore",
    "robotstudio",
    "robotware",
    "industrial-robot"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ichbinmeraj/abb-rws-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/ichbinmeraj/abb-rws-client.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "readme:gen": "npm run build && node scripts/gen-readme-tables.mjs",
    "readme:check": "npm run build && node scripts/gen-readme-tables.mjs --check",
    "structural": "node scripts/structural.mjs",
    "functional": "node scripts/functional.mjs",
    "functional:fixtures": "node scripts/functional-fixtures.mjs",
    "functional:pendant": "node scripts/functional-pendant.mjs",
    "vc-ready": "node scripts/vc-ready.mjs",
    "conformance": "node scripts/conformance.mjs",
    "prepack": "npm ls --omit=dev && node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && node -e \"delete process.env.RWS_TEST_HOST; try { require('child_process').execSync('npm test', { stdio: 'inherit' }) } catch { process.exit(1) }\"",
    "prepublishOnly": "npm run build && node -e \"delete process.env.RWS_TEST_HOST; try { require('child_process').execSync('npm test', { stdio: 'inherit' }) } catch { process.exit(1) }\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
